<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_glass_surface">

    <!-- ═══ GLASS TOP BAR ═══ -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_bottom_nav"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvResponderIdentity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛡️ RESPONDER MODE"
                android:textColor="@color/evac_accent"
                android:textSize="@dimen/text_body"
                android:textStyle="bold"
                android:letterSpacing="0.05" />

            <TextView
                android:id="@+id/tvSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Syncing location..."
                android:textColor="@color/text_tertiary"
                android:textSize="@dimen/text_caption" />
        </LinearLayout>

        <ImageView
            android:id="@+id/btnLogout"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center_vertical"
            android:src="@android:drawable/ic_lock_power_off"
            android:background="@drawable/bg_glass_status_badge"
            android:padding="4dp"
            app:tint="@color/error_red" />
    </LinearLayout>

    <!-- ═══ MAP AREA (Top 50%) ═══ -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="0.5"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- ═══ GLASS TASK LIST HEADER ═══ -->
    <TextView
        android:id="@+id/tvTaskHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_glass_bottom_nav"
        android:padding="14dp"
        android:text="NEARBY ALERTS (5KM)"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_small"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        app:layout_constraintTop_toBottomOf="@id/mapView" />

    <!-- ═══ TASK LIST ═══ -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvTasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTaskHeader" />

</androidx.constraintlayout.widget.ConstraintLayout>
