<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:gravity="center_vertical"
    android:background="#0D1117"
    android:layout_marginBottom="1dp">

    <!-- Type icon -->
    <ImageView
        android:id="@+id/iv_spot_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:src="@drawable/ic_spot_default"
        android:contentDescription="Spot type icon" />

    <!-- Name + Type -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/tv_spot_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#E6EDF3"
            android:textSize="14sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/tv_spot_type"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8B949E"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>

    <!-- Distance + Direction -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:id="@+id/tv_spot_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#58A6FF"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_spot_direction"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8B949E"
            android:textSize="11sp"
            android:layout_marginTop="2dp" />
    </LinearLayout>
</LinearLayout>
