<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1a1a2e">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp"
        android:gravity="center_horizontal">

        <!-- ═══ PROXIMITY ALERT BANNER (hidden by default) ═══ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/proximityBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:visibility="gone"
            app:cardBackgroundColor="#CC331a00"
            app:cardCornerRadius="10dp"
            app:strokeColor="#FFaa44"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/proximityText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="⚠️ Survivor nearby"
                    android:textColor="#FFcc88"
                    android:textSize="14sp"
                    android:lineSpacingExtra="4dp"/>

                <TextView
                    android:id="@+id/proximityDismiss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="✕"
                    android:textColor="#FFcc88"
                    android:textSize="20sp"
                    android:padding="8dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="EMERGENCY SOS"
            android:textSize="28sp"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />


        <TextView
            android:id="@+id/tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap a button to send distress signal"
            android:textSize="14sp"
            android:textColor="#AAAAAA"
            android:layout_marginBottom="24dp" />

        <!-- SOS Buttons Grid: 2x2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_medical"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:text="🏥\nMEDICAL"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#E53935"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_trapped"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:text="🧱\nTRAPPED"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#FF8F00"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hazard"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:text="⚠️\nHAZARD"
                android:textSize="16sp"
                android:textColor="#1a1a2e"
                android:backgroundTint="#FDD835"
                android:layout_marginEnd="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_safe"
                android:layout_width="0dp"
                android:layout_height="120dp"
                android:layout_weight="1"
                android:text="✅\nSAFE"
                android:textSize="16sp"
                android:textColor="#FFFFFF"
                android:backgroundTint="#43A047"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Acoustic Beacon -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_beacon"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="📢 SOUND BEACON (Victim Locator)"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#00d4ff"
            android:layout_marginBottom="16dp" />

        <!-- People Count -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="People Count"
            android:textSize="16sp"
            android:textColor="#CCCCCC"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_people_minus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:text="−"
                android:textSize="20sp"
                android:textColor="#FFFFFF" />

            <TextView
                android:id="@+id/tv_people_count"
                android:layout_width="80dp"
                android:layout_height="48dp"
                android:gravity="center"
                android:text="1"
                android:textSize="24sp"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_people_plus"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="56dp"
                android:layout_height="48dp"
                android:text="+"
                android:textSize="20sp"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Note -->
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:hint="Optional note (100 chars)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_note"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLength="100"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Mesh Status -->
        <TextView
            android:id="@+id/tv_mesh_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📡 Mesh: Scanning..."
            android:textSize="13sp"
            android:textColor="#66BB6A"
            android:gravity="center"
            android:layout_marginTop="8dp" />

    </LinearLayout>
</ScrollView>
