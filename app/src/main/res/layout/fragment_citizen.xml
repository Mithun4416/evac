<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_glass_surface"
    android:paddingHorizontal="@dimen/screen_padding"
    android:paddingVertical="12dp"
    android:gravity="center_horizontal">

    <!-- ═══ PROXIMITY ALERT BANNER (hidden by default) ═══ -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/proximityBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/sos_trapped_bg"
        app:cardCornerRadius="@dimen/card_radius_small"
        app:cardElevation="0dp"
        app:strokeColor="@color/sos_trapped_border"
        app:strokeWidth="@dimen/glass_border_width_strong">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/proximityText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Survivor nearby"
                android:textColor="@color/evac_orange"
                android:textSize="@dimen/text_small"
                android:lineSpacingExtra="2dp"/>

            <TextView
                android:id="@+id/proximityDismiss"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="X"
                android:textColor="@color/evac_orange"
                android:textSize="18sp"
                android:padding="6dp"/>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- ═══ LOGO (left) + MESH STATUS (right) ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <ImageView
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/ic_evac_logo"
            android:tint="@color/evac_accent"
            android:contentDescription="EVAC Logo" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/tv_mesh_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mesh: Scanning..."
            android:textSize="@dimen/text_caption"
            android:textColor="@color/success_green"
            android:background="@drawable/bg_glass_status_badge"
            android:paddingHorizontal="14dp"
            android:paddingVertical="5dp"
            android:gravity="center" />
    </LinearLayout>

    <!-- ═══ HEADER ═══ -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EMERGENCY SOS"
        android:textSize="@dimen/text_headline"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="2dp" />

    <TextView
        android:id="@+id/tv_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tap a button to send distress signal"
        android:textSize="@dimen/text_body"
        android:textColor="@color/text_secondary"
        android:layout_marginBottom="12dp" />

    <!-- ═══ SOS BUTTONS GRID: 2×2 ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <!-- MEDICAL -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_medical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="MEDICAL"
                android:textSize="20sp"
                android:textColor="@color/sos_medical"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:background="@drawable/bg_sos_medical"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@null"
                app:rippleColor="@color/sos_medical_bg" />

            <!-- TRAPPED -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_trapped"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="TRAPPED"
                android:textSize="20sp"
                android:textColor="@color/sos_trapped"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:background="@drawable/bg_sos_trapped"
                android:layout_marginStart="4dp"
                app:backgroundTint="@null"
                app:rippleColor="@color/sos_trapped_bg" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <!-- HAZARD -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_hazard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="HAZARD"
                android:textSize="20sp"
                android:textColor="@color/sos_hazard"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:background="@drawable/bg_sos_hazard"
                android:layout_marginEnd="4dp"
                app:backgroundTint="@null"
                app:rippleColor="@color/sos_hazard_bg" />

            <!-- SAFE -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_safe"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="SAFE"
                android:textSize="20sp"
                android:textColor="@color/sos_safe"
                android:textStyle="bold"
                android:letterSpacing="0.05"
                android:background="@drawable/bg_sos_safe"
                android:layout_marginStart="4dp"
                app:backgroundTint="@null"
                app:rippleColor="@color/sos_safe_bg" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ ACOUSTIC BEACON ═══ -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_beacon"
        android:layout_width="match_parent"
        android:layout_height="@dimen/button_height"
        android:text="SOUND BEACON"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/beacon_cyan"
        android:letterSpacing="0.05"
        android:background="@drawable/bg_beacon_button"
        android:layout_marginBottom="12dp"
        app:backgroundTint="@null"
        app:rippleColor="@color/beacon_bg" />

    <!-- ═══ PEOPLE COUNT (Glass Card) ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_glass_card"
        android:paddingVertical="10dp"
        android:paddingHorizontal="@dimen/card_padding"
        android:gravity="center_horizontal"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="People Count"
            android:textSize="@dimen/text_body"
            android:textColor="@color/text_secondary"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_people_minus"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:text="−"
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_glass_button"
                app:backgroundTint="@null"
                app:rippleColor="@color/glass_border" />

            <EditText
                android:id="@+id/tv_people_count"
                android:layout_width="72dp"
                android:layout_height="44dp"
                android:gravity="center"
                android:text="1"
                android:textSize="22sp"
                android:textColor="@color/text_primary"
                android:textStyle="bold"
                android:inputType="number"
                android:background="@android:color/transparent"
                android:maxLength="3" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_people_plus"
                android:layout_width="48dp"
                android:layout_height="44dp"
                android:text="+"
                android:textSize="20sp"
                android:textColor="@color/text_primary"
                android:background="@drawable/bg_glass_button"
                app:backgroundTint="@null"
                app:rippleColor="@color/glass_border" />
        </LinearLayout>
    </LinearLayout>

    <!-- ═══ NOTE FIELD ═══ -->
    <com.google.android.material.textfield.TextInputLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Optional note (100 chars)"
        style="@style/GlassTextInput"
        android:layout_marginBottom="4dp">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxLength="100"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_tertiary"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

</LinearLayout>
